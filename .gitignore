# Project: large data and model weights — NEVER commit
data/raw/
data/processed/
data/external/
*.fastq
*.fastq.gz
*.npz
*.npy
*.pt
*.pth
*.bin
*.safetensors
*.gguf
*.zip
*.tar.gz
*.tgz

# Results: keep small text artefacts in git, block large binaries
results/runs/**/*.pdb
results/runs/**/*.cif
results/runs/**/inputs/*.pdb
results/runs/**/inputs/*.cif

# AF3 Server outputs — large binary CIFs + JSON/MSA bundles (~150 MB per variant).
# Provenance lives in notes/plm/verification-log.md (per-ZIP SHA-256); the raw outputs
# are reproducible from the submitted FASTA + provided sequences via alphafoldserver.com.
data/browser_submissions/af3_server_output/

# Allow small reference data deliberately
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep
!results/runs/.gitkeep

# Secrets
.env
.env.*
!.env.example
*.key
*.pem
secrets.yaml
secrets.json

# Local Claude Code settings (user-specific permissions, not for the team)
.claude/settings.local.json
.claude/scheduled_tasks.lock
